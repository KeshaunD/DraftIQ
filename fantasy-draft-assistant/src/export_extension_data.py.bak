def load_json(path, default=None):
    if not path.exists():
        return default

    with open(path, "r", encoding="utf-8") as file:
        return json.load(file)


def safe_number(value, default=None):
    if value in [None, "", "-"]:
        return default

    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def safe_round(value, digits=1, default=0):
    number = safe_number(value, default=None)

    if number is None:
        return default

    return round(number, digits)


def clean_name(name):
    name = str(name or "")
    name = re.sub(r"\s+", " ", name).strip()

    name = re.sub(
        r"\s+(ARI|ATL|BAL|BUF|CAR|CHI|CIN|CLE|DAL|DEN|DET|GB|GNB|HOU|IND|JAX|JAC|KC|KAN|LV|LVR|LAC|LAR|LA|MIA|MIN|NE|NWE|NO|NOR|NYG|NYJ|PHI|PIT|SEA|SF|SFO|TB|TAM|TEN|WAS|WSH)\s+(QB|RB|WR|TE|K|PK|DST|DEF)$",
        "",
        name,
    )

    name = re.sub(r"\s+\((QB|RB|WR|TE|K|PK|DST|DEF)\)$", "", name)

    return name.strip()


def canonical_player_name(name):
    cleaned = clean_name(name)
    return NAME_ALIASES.get(cleaned, cleaned)


def normalize_name(name):
    name = canonical_player_name(name).lower()
    name = name.replace(".", "")
    name = name.replace("'", "")
    name = name.replace("’", "")
    name = name.replace("-", " ")
    name = re.sub(r"\b(jr|sr|ii|iii|iv|v)\b", "", name)
    name = re.sub(r"[^a-z0-9\s]", " ", name)
    name = re.sub(r"\s+", " ", name).strip()
    return name


def lookup_name_variants(name):
    cleaned = clean_name(name)
    canonical = canonical_player_name(cleaned)

    variants = {cleaned, canonical}

    for alias_name, preferred_name in NAME_ALIASES.items():
        if canonical_player_name(alias_name) == canonical:
            variants.add(alias_name)
            variants.add(preferred_name)

        if canonical_player_name(preferred_name) == canonical:
            variants.add(alias_name)
            variants.add(preferred_name)

    return [variant for variant in variants if variant]


def normalize_team(team):
    if not team:
        return None

    team = str(team).upper().strip()
    return TEAM_ALIASES.get(team, team)


def normalize_position(position):
    if not position:
        return None

    position = str(position).upper().strip()

    if position == "K":
        return "PK"

    if position in ["DST", "DEF"]:
        return "D/ST"

    return position


def is_skill_position(position):
    return normalize_position(position) in SKILL_POSITIONS


def first_value(data, keys, default=None):
    if not isinstance(data, dict):
        return default

    for key in keys:
        value = data.get(key)
        if value not in [None, "", "-"]:
            return value

    return default


def average_values(source_values, digits=1):
    usable_values = []
    usable_sources = []

    for source, value in source_values.items():
        number = safe_number(value, default=None)

        if number is None:
            continue

        usable_values.append(number)
        usable_sources.append(source)

    if not usable_values:
        return None, []

    return round(sum(usable_values) / len(usable_values), digits), usable_sources


def rounded_source_map(source_values, digits=1):
    rounded = {}

    for source, value in source_values.items():
        number = safe_number(value, default=None)

        if number is None:
            rounded[source] = None
        else:
            rounded[source] = round(number, digits)

    return rounded


def source_label(sources, fallback="ranking"):
    if not sources:
        return fallback

    if len(sources) == 1:
        return sources[0]

    return "average"


def get_export_rank(player, index):
    rank = first_value(
        player,
        [
            "rank",
            "overall_rank",
            "overallRank",
            "draftiq_rank",
            "draftRank",
        ],
        default=None,
    )

    rank_number = safe_number(rank, default=None)

    if rank_number is None or rank_number >= 999:
        return index

    return int(rank_number)


def get_tier(rank):
    if rank <= 12:
        return 1
    if rank <= 24:
        return 2
    if rank <= 36:
        return 3
    if rank <= 60:
        return 4
    if rank <= 90:
        return 5
    return 6


def build_headshot_url(player_id):
    if not player_id:
        return None

    return f"https://a.espncdn.com/i/headshots/nfl/players/full/{player_id}.png"


def build_draft_badge(rank, adp):
    rank_number = safe_number(rank, default=None)
    adp_number = safe_number(adp, default=None)

    if rank_number is None or adp_number is None:
        return {
            "label": "FAIR",
            "type": "fair",
            "value": 0,
        }

    value = round(adp_number - rank_number, 1)

    if value >= 10:
        return {
            "label": "STEAL",
            "type": "steal",
            "value": value,
        }

    if value <= -10:
        return {
            "label": "REACH",
            "type": "reach",
            "value": value,
        }

    return {
        "label": "FAIR",
        "type": "fair",
        "value": value,
    }


def get_bye_week(player, bye_weeks):
    team = normalize_team(player.get("team"))

    if team and team in bye_weeks:
        return bye_weeks[team]

    return player.get("bye", "-")


def build_external_source_lookup(records):
    lookup = {
        "by_id": {},
        "by_name": {},
    }

    if not isinstance(records, list):
        return lookup

    for item in records:
        if not isinstance(item, dict):
            continue

        ids = [
            item.get("id"),
            item.get("espnId"),
            item.get("espn_id"),
            item.get("playerId"),
            item.get("athleteId"),
            item.get("sleeperId"),
            item.get("sleeper_id"),
        ]

        for player_id in ids:
            if player_id in [None, "", "-"]:
                continue

            lookup["by_id"][str(player_id)] = item

        name = first_value(
            item,
            ["name", "player", "playerName", "fullName", "displayName", "sleeperName"],
            default=None,
        )

        if not name:
            continue

        for variant in lookup_name_variants(name):
            key = normalize_name(variant)

            if not key:
                continue

            lookup["by_name"].setdefault(key, []).append(item)

    return lookup


def find_external_source_match(player, player_id, source_lookup):
    if not isinstance(source_lookup, dict):
        return None

    id_candidates = [
        player_id,
        player.get("id"),
        player.get("espnId"),
        player.get("espn_id"),
        player.get("playerId"),
        player.get("athleteId"),
        player.get("sleeperId"),
        player.get("sleeper_id"),
    ]

    for candidate in id_candidates:
        if candidate in [None, "", "-"]:
            continue

        match = source_lookup.get("by_id", {}).get(str(candidate))

        if match:
            return match

    player_name = player.get("name")

    if not player_name:
        return None

    player_team = normalize_team(first_value(player, ["team", "tm"], default=None))
    player_position = normalize_position(first_value(player, ["position", "pos"], default=None))

    for variant in lookup_name_variants(player_name):
        matches = source_lookup.get("by_name", {}).get(normalize_name(variant), [])

        if not matches:
            continue

        if len(matches) == 1:
            return matches[0]

        for match in matches:
            match_team = normalize_team(first_value(match, ["team", "tm"], default=None))
            match_position = normalize_position(first_value(match, ["pos", "position"], default=None))

            if player_team and match_team and player_team == match_team:
                return match

            if player_position and match_position and player_position == match_position:
                return match

        return matches[0]

    return None


def build_projection_lookup(projections):
    lookup = {}

    if isinstance(projections, dict):
        iterable = projections.items()
    elif isinstance(projections, list):
        iterable = []

        for item in projections:
            if not isinstance(item, dict):
                continue

            name = first_value(
                item,
                ["name", "player", "playerName", "fullName", "displayName"],
                default=None,
            )

            if name:
                iterable.append((name, item))
    else:
        return lookup

    for name, projection_data in iterable:
        if not name:
            continue

        if not isinstance(projection_data, dict):
            projection_data = {
                "projection": projection_data,
                "source": "yahoo",
            }

        for variant in lookup_name_variants(name):
            key = normalize_name(variant)

            if key:
                lookup[key] = projection_data

    return lookup


def find_projection_profile(player, projection_lookup):
    name = player.get("name")

    if not name:
        return None

    for variant in lookup_name_variants(name):
        match = projection_lookup.get(normalize_name(variant))

        if match:
            return match

    return None


def get_legacy_projection_value(player, projection_profile=None):
    if projection_profile:
        projected_value = first_value(
            projection_profile,
            [
                "projection",
                "projected_points",
                "projectedPoints",
                "fantasy_points",
                "fantasyPoints",
                "ppr",
                "points",
            ],
            default=None,
        )

        if projected_value not in [None, "", "-"]:
            return projected_value

    return first_value(
        player,
        [
            "projection",
            "projected_points",
            "projectedPoints",
            "proj",
        ],
        default=None,
    )


def get_legacy_projected_ppg(player, projection_profile=None):
    if projection_profile:
        ppg = first_value(
            projection_profile,
            [
                "projectedPpg",
                "projected_ppg",
                "ppg",
                "pointsPerGame",
            ],
            default=None,
        )

        if ppg not in [None, "", "-"]:
            return ppg

    projection = get_legacy_projection_value(player, projection_profile)
    projection_number = safe_number(projection, default=None)

    if projection_number is None:
        return None

    return projection_number / 17


