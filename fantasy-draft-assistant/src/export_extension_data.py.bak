def build_source_projections(player, projection_profile=None, espn_projection=None, sleeper_projection=None):
    return rounded_source_map(
        {
            "yahoo": get_legacy_projection_value(player, projection_profile),
            "espn": get_espn_projection_value(espn_projection),
            "sleeper": get_sleeper_projection_value(sleeper_projection),
        },
        digits=1,
    )


