{
  "manifest_version": 3,
  "name": "Draft Copilot — Fantasy Draft HUD",
  "version": "0.1.0",
  "description": "A tiered value-rail HUD that overlays your fantasy draft room so you never miss a steal.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Draft Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.espn.com/*",
        "*://*.fantasysports.yahoo.com/*",
        "*://sleeper.com/*",
        "*://sleeper.app/*",
        "*://*.nfl.com/*"
      ],
      "js": [
        "data.js",
        "styles.js",
        "mock-history.js",
        "draft-sync.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}