	function moveTentacle(_img, _canvas, _waveAmp, _waveLen, _speed){
    	const canvas = document.getElementById(_canvas);
		const ctx = canvas.getContext("2d");

		const img = new Image();
		img.src = _img;

		//img.crossOrigin = "anonymous";

		img.onload = () => {
		  canvas.width = img.width / 2;
		  canvas.height = img.height / 2;
		  animate();
		};

		let time = 0;
		let animationId = null;

		function animate() {

			ctx.clearRect(0, 0, canvas.width, canvas.height);
			// const waveAmplitude = 8;
			// const waveLength = 0.02;
			// const speed = 0.04;

			const waveAmplitude = _waveAmp;
			const waveLength = _waveLen;
			const speed = _speed;

			for (let y = 0; y < canvas.height; y++) {
				const offsetX = Math.sin((y * waveLength) + time) * waveAmplitude;

				ctx.drawImage(
					img,
					0, y * 2, img.width, 2,
					offsetX, y, canvas.width, 1
					);
			}

			time += speed;
			animationId = requestAnimationFrame(animate);
		}

		function stopTenta() {
			if (animationId !== null) {
		    	cancelAnimationFrame(animationId);
		      	animationId = null;
		    }
		}

		return {
			stopTenta
		};
	};

	function createPuff(_holder, _qty, _puffSize, _spanX, _spanY, _spreadY){

		gsap.set(_holder, {x:297, y:10, alpha:0});
		gsap.to(_holder, {duration:.4, alpha:1, ease:"power3.inOut"});

		for(let i = 0; i < _qty; i ++){
			const _p = document.createElement('div');
			_p.style.width = _puffSize + 'px';
			_p.style.height = _puffSize + 'px';
			_p.style.backgroundImage = "radial-gradient(circle at center, rgba(181, 152, 255, 50) 0%, rgba(118, 100, 255, 0) 90%)";
			_p.style.borderRadius = _puffSize + 'px'
			_p.style.position = 'absolute';

			gsap.set(_p, {x:-_spanX + Math.random()*(_spanX * 2) - (_puffSize/2), y:Math.random()*_spanY});
			gsap.to(_p, {duration:1 + Math.random()*.5, x:"+=" + (-60 + Math.random()*120), y:"+=" + (-_spreadY + Math.random()*(_spreadY * 2)), alpha:0, scale:.3 + Math.random()*.5});

			_holder.append(_p);
		}
	};

	function createSparks(_holder, _qty, _sparkSize, _spanX, _spanY, _spreadY){

		gsap.set(_holder, {x:297, y:10, alpha:0});
		gsap.to(_holder, {duration:.3, alpha:1, ease:"power3.inOut"});

		for(let i = 0; i < _qty; i ++){
