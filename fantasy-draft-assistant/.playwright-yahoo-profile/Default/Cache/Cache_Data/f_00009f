			myFT.instantAds.img_elem5,
			myFT.instantAds.img_elem6,
			myFT.instantAds.img_elem7,
			myFT.instantAds.tentacleRight,
			myFT.instantAds.ef_img,
			myFT.instantAds.extra_img,
			myFT.instantAds.offer_boltOn_img,
			"images/CMI26_1158550_X26_Minions_wifi.svg",
		].filter(url => url && url !== '' && url !== 'images/blank.png');

		let loadedCount = 0;
		const totalImages = imageUrls.length;

		if (totalImages === 0) {
			console.dev('No images to preload');
			callback();
			return;
		}

		console.dev(`Starting to preload ${totalImages} images...`);

		imageUrls.forEach(url => {
			const img = new Image();
			img.onload = img.onerror = function() {
				loadedCount++;
				if (loadedCount === totalImages) {
					const endTime = performance.now();
					const loadTime = ((endTime - startTime) / 1000).toFixed(2);
					console.dev(`All ${totalImages} images loaded in ${loadTime}s`);
					callback();
				}
			};
			img.src = url;
		});
	}

